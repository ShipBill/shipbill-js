# From the ShipBill dashboard (test mode while you try it).
# Website integration → API keys: a secret key. Every ShipBill call is from this server.
SHIPBILL_SECRET_KEY=sk_test_…
# Products → the product's "For developers" tab.
SHIPBILL_PRODUCT=prod_…

# Test keys accept a local return address, so the provider can bring the buyer back here.
PORT=4700
SITE_URL=http://localhost:4700
