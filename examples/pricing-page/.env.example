# From the ShipBill dashboard (test mode while you try it).
# Website integration → API keys
SHIPBILL_SECRET_KEY=sk_test_…
SHIPBILL_PUBLISHABLE_KEY=pk_test_…
# Products → each product's "For developers" tab. Two subscription products.
SHIPBILL_BASIC_PRODUCT=prod_…
SHIPBILL_PRO_PRODUCT=prod_…

# How this site learns about payments:
#   webhook  ShipBill calls https://<your site>/webhooks/shipbill. Add that address in Settings → Webhook and
#            put its signing secret below.
#   poll     reads ShipBill's events every few seconds, for a laptop ShipBill can't reach.
SHIPBILL_EVENTS=poll
SHIPBILL_WEBHOOK_SECRET=whsec_…

# Add this address in Website integration → Allowed websites, so the checkout can open over its pages.
PORT=4600
SITE_URL=http://localhost:4600
