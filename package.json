{
  "name": "shipbill-js",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "generate": "bun scripts/generate.ts",
    "build": "bun run --filter './packages/*' build",
    "typecheck": "bun run --filter './packages/*' typecheck",
    "test": "bun test packages examples",
    "lint": "biome check . && bun scripts/check-imports.ts",
    "contract": "bun scripts/contract.ts",
    "check": "bun run lint && bun run typecheck && bun run build && bun scripts/check-published.ts && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "^1.3.0",
    "playwright-core": "1.63.0",
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0"
  }
}
